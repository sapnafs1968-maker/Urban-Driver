# ==========================================
# URBAN DRIVER - ENVIRONMENT CONFIGURATION
# ==========================================
# Urban Driver includes a seamless In-Memory / Local Demo Mode
# which allows running all workflows immediately when Supabase or
# third-party payment/SMS keys are not configured.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Driving Licence Verification Provider Mode
# Options: 'demo' (free, simulated local engine) | 'live' (HyperVerge or live government API)
DL_VERIFICATION_MODE=demo
NEXT_PUBLIC_DL_VERIFICATION_MODE=demo

# HyperVerge Live API Credentials (Required ONLY when DL_VERIFICATION_MODE=live)
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=

# Supabase (PostgreSQL, Auth, Storage, Realtime)
# Replace with your Supabase Project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Payment Gateway (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Twilio / MSG91 SMS Provider (Optional for real OTP/SMS)
SMS_PROVIDER=demo # 'twilio' | 'msg91' | 'demo'
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business Cloud API (Optional for automated messaging)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_SUPPORT_PHONE_NUMBER=+91 1800 555 0199

# Platform Configuration
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
